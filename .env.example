# The name of the application
APP_NAME=WebServiceTemplate

# The current environment of the application
# Options: development, staging, production
APP_ENV=development

# The port number where the application is running
PORT=3000

# PostgreSQL connection URL used by the Prisma CLI (prisma.config.ts) and by
# the runtime PrismaPg adapter. Must use the postgresql:// or postgres:// scheme
# and include a host. The example matches .dev-app-projects/docker-compose.yaml.
# Optional ?schema=<name> selects a PostgreSQL schema (default: public).
DATABASE_URL=postgresql://appUser:appPassword@localhost:5432/app_db

# Maximum number of pooled database connections (positive integer, default 10).
# DATABASE_POOL_MAX=10

# Milliseconds to wait for a new connection or a free pool slot before failing
# (positive integer, default 10000).
# DATABASE_CONNECTION_TIMEOUT_MS=10000
