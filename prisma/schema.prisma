// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// The datasource URL, migrations path and seed command are configured in the
// root prisma.config.ts (Prisma CLI). The runtime connection is created by
// src/core/services/prisma.service.ts through the PostgreSQL driver adapter.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

model log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("Log")
}
